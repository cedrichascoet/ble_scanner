[bluetooth]
# How often (seconds) absent devices are checked; scanning itself is continuous
scan_duration = 2.0
# Seconds without a detection before marking as not_home
expiry_time = 60
# Minimum seconds between attribute (RSSI, last_seen) updates while present
attr_interval = 30

[devices]
# mac = nickname  (nickname is used in MQTT topic and HA entity name)
AA:BB:CC:DD:EE:FF = tracker1
BB:CC:DD:EE:FF:00 = tracker2

[mqtt]
host = 192.168.x.x
port = 1883
user = mqtt
password = changeme
# $(hostname) is expanded at runtime; default is homeassistant/$(hostname)
topic = homeassistant/$(hostname)

[logging]
# DEBUG, INFO, WARNING or ERROR
level = INFO
